# Base URL of the FastAPI REST service (routes, stops). Leave unset to run
# entirely on bundled demo data.
NEXT_PUBLIC_API_URL=

# WebSocket URL of the FastAPI live-bus feed, e.g. wss://api.gatisync.in/ws/buses
# Leave unset (or set NEXT_PUBLIC_DEMO_MODE=true) to run the Demo Mode
# simulator instead — no backend required.
NEXT_PUBLIC_WS_URL=

# Force demo mode even if NEXT_PUBLIC_WS_URL is set. Useful for local dev
# against a backend that isn't running yet.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: override the map tile URL template (e.g. a self-hosted vector
# tile server or Mapbox raster endpoint). Defaults to CARTO Voyager tiles.
NEXT_PUBLIC_MAP_URL=
